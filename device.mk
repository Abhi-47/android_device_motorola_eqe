# eSIM: politica euicc de Motorola (LineageOS org.lineageos.euicc, compatible Vanilla)
PRODUCT_PACKAGES += \
    MotoEuicc

# Extensiones de camara de Moto (CameraX Extensions) + declaracion de la
# libreria compartida androidx.camera.extensions.impl. Estan en el firmware
# stock A16 y faltaban en esta ROM. Se declaran aca y no en el makefile
# generado del repo vendor, porque ese se regenera con extract-files y
# perderia estas lineas.
PRODUCT_COPY_FILES += \
    vendor/motorola/eqe/proprietary/vendor/framework/com.motorola.camera.extensions.jar:$(TARGET_COPY_OUT_VENDOR)/framework/com.motorola.camera.extensions.jar \
    vendor/motorola/eqe/proprietary/vendor/framework/oat/arm/com.motorola.camera.extensions.odex:$(TARGET_COPY_OUT_VENDOR)/framework/oat/arm/com.motorola.camera.extensions.odex \
    vendor/motorola/eqe/proprietary/vendor/framework/oat/arm/com.motorola.camera.extensions.vdex:$(TARGET_COPY_OUT_VENDOR)/framework/oat/arm/com.motorola.camera.extensions.vdex \
    vendor/motorola/eqe/proprietary/vendor/framework/oat/arm64/com.motorola.camera.extensions.odex:$(TARGET_COPY_OUT_VENDOR)/framework/oat/arm64/com.motorola.camera.extensions.odex \
    vendor/motorola/eqe/proprietary/vendor/framework/oat/arm64/com.motorola.camera.extensions.vdex:$(TARGET_COPY_OUT_VENDOR)/framework/oat/arm64/com.motorola.camera.extensions.vdex \
    vendor/motorola/eqe/proprietary/vendor/etc/permissions/com.motorola.camera.extensions.xml:$(TARGET_COPY_OUT_VENDOR)/etc/permissions/com.motorola.camera.extensions.xml

# Permisos de Motorola que usa Moto Camera. En el firmware stock los declara el
# framework de Motorola y su platform.xml los mapea al grupo de sistema
# "camera", que es lo que abre los dispositivos de imagen (JPEG por hardware,
# CVP, gemini/ISP, subdevs). En una ROM AOSP no existen: sin ellos la app no
# obtiene ese grupo, no puede usar su motor de imagen y las fotos salen planas.
PRODUCT_PACKAGES += MotoPermissions
PRODUCT_COPY_FILES += \
    $(LOCAL_PATH)/moto-permissions/moto-permissions.xml:$(TARGET_COPY_OUT_SYSTEM)/etc/permissions/moto-permissions.xml

# Vendor VINTF
DEVICE_VENDOR_COMPATIBILITY_MATRIX_FILE += \
    vendor/motorola/eqe/compatibility_matrix.xml

    firmware_wlan_mac.bin_symlink \
    firmware_WCNSS_qcom_cfg.ini_symlink

