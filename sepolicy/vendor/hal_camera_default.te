# Camera HAL SEPolicy
type hal_camera_default, hal_camera_default_type, hal_camera_default_typeattr;
type hal_camera_default_exec, hal_camera_default_exec_type, hal_camera_default_exec_typeattr;

hal_server_domain(hal_camera_default, hal_camera_default_type, hal_camera_default_typeattr)
hal_client_domain(hal_camera_default, hal_camera_default_type, hal_camera_default_typeattr)

# Allow camera HAL to access camera provider service
allow hal_camera_default vendor_hal_arcsoftpp_service:service_manager { add find };

# Camera provider service permissions
allow hal_camera_default self:capability { sys_nice };
allow hal_camera_default camera_device:chr_file { open read write ioctl };
allow hal_camera_default cameraserver:process { getattr };
allow hal_camera_default cameraserver:unix_stream_socket { connectto };
allow hal_camera_default vendor_camera_prop:property_service { set };

# Allow camera HAL to read/write camera firmware and config
allow hal_camera_default vendor_file:file { read open };
allow hal_camera_default vendor_configs_file:file { read open };
allow hal_camera_default vendor_firmware_file:file { read open };

# GPU/ion access for camera
allow hal_camera_default gpu_device:chr_file { open read write ioctl };
allow hal_camera_default ion_device:chr_file { open read write ioctl };

# VINTF/HIDL services
allow hal_camera_default hal_camera_default:hwbinder_service { find };
allow hal_camera_default vendor_qti_camera_provider_service:hwbinder_service { find };
allow hal_camera_default vendor_qti_camera_postproc_service:hwbinder_service { find };
allow hal_camera_default vendor_qti_camera_aon_service:hwbinder_service { find };
allow hal_camera_default vendor_arcsoft_camera_postproc_service:hwbinder_service { find };